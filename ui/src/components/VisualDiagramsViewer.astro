---
import { VISUAL_DIAGRAMS_CONFIG } from '../utils/visual-diagrams';
import { MERMAID_DIAGRAMS } from '../utils/mermaid-definitions';

interface Props {
  diagrams: { id: string; title: string; filename: string; content: string }[];
}

const { diagrams } = Astro.props;
---

<div class="visual-diagrams-layout">
  <!-- LEFT BLUEPRINT NAVIGATION SIDEBAR -->
  <aside class="diag-nav-sidebar">
    <div class="diag-nav-header">
      <div class="blueprint-badge">ARCHITECTURAL BLUEPRINTS</div>
      <h3>System Models & Flowcharts</h3>
      <p>Formal causal diagrams for security researchers</p>
    </div>

    <div class="diag-btn-list">
      {VISUAL_DIAGRAMS_CONFIG.map((vd, index) => (
        <button class={`diag-select-btn ${index === 0 ? 'active' : ''}`} data-diagram-id={vd.id}>
          <div class="btn-top-row">
            <span class="btn-num">MODEL 0{vd.number}</span>
            <span class="btn-type-pill">{vd.number === 4 ? 'LOGIC GATE' : vd.number === 5 ? 'TREE' : 'SEQUENCE'}</span>
          </div>
          <span class="btn-title">{vd.title}</span>
          <span class="btn-sub">{vd.subtitle}</span>
        </button>
      ))}
    </div>

    <!-- REPO PROVENANCE FOOTER -->
    <div class="sidebar-provenance">
      <span>Repository Specification:</span>
      <code>content/topics/csrf/diagrams/</code>
    </div>
  </aside>

  <!-- MAIN DIAGRAM WORKSPACE -->
  <main class="diag-main-display">
    <!-- TOP WORKSPACE TOOLBAR -->
    <header class="diag-toolbar">
      <div class="diag-meta-titles">
        <div class="diag-meta-tag" id="activeDiagramTag">DIAGRAM 01 &bull; TRUST BOUNDARY</div>
        <h2 id="activeDiagramTitle">1. Origin-Context Trust Boundary</h2>
        <p id="activeDiagramSub">How untrusted origins exploit the browser runtime as a Confused Deputy</p>
      </div>

      <!-- VIEW MODE & CANVAS CONTROLS -->
      <div class="diag-controls-group">
        <!-- 3-WAY VIEW TOGGLE -->
        <div class="view-mode-toggle">
          <button class="toggle-btn active" id="btnModeSvg" title="Interactive Vector Architecture Diagram">
            <span>🎨</span> Vector SVG
          </button>
          <button class="toggle-btn" id="btnModeMermaid" title="Mermaid Graph & Sequence Diagram">
            <span>📊</span> Mermaid
          </button>
          <button class="toggle-btn" id="btnModeAscii" title="Canonical Raw ASCII Specification">
            <span>📝</span> Raw ASCII
          </button>
        </div>

        <!-- CANVAS ZOOM CONTROLS -->
        <div class="canvas-zoom-tools">
          <button class="tool-btn" id="btnZoomOut" title="Zoom Out">&minus;</button>
          <span class="zoom-indicator" id="zoomLevelText">100%</span>
          <button class="tool-btn" id="btnZoomIn" title="Zoom In">&plus;</button>
          <button class="tool-btn" id="btnZoomReset" title="Reset Zoom">⟲</button>
        </div>

        <!-- COPY ACTION -->
        <button class="action-btn" id="btnCopyDiagramSpec">
          <span>📋</span> Copy Spec
        </button>
      </div>
    </header>

    <!-- INVARIANT BANNER -->
    <div class="diag-takeaway-banner">
      <div class="banner-badge">SECURITY INVARIANT</div>
      <span id="activeTakeawayText">The target server evaluates identity (valid session cookie) but fails to evaluate provenance (originating context).</span>
    </div>

    <!-- VIEWPORT WORKSPACE -->
    <div class="diag-workspace-container" id="diagCanvasContainer">
      <!-- 1. VECTOR SVG VIEWPORT -->
      <div id="svgViewport" class="diagram-viewport-panel active">
        <div class="svg-zoom-wrapper" id="svgZoomTarget">

          <!-- ================= DIAGRAM 1: TRUST BOUNDARY ================= -->
          <div class="svg-flow-card active" id="svg_diag_1">
            <svg viewBox="0 0 1060 620" class="arch-svg-canvas" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <marker id="arrow-red" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 8 5 L 0 9 z" fill="#ff5252" />
                </marker>
                <marker id="arrow-cyan" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 8 5 L 0 9 z" fill="#4dd8d8" />
                </marker>
                <marker id="arrow-green" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                  <path d="M 0 1 L 8 5 L 0 9 z" fill="#52dc88" />
                </marker>
                <linearGradient id="grad-attacker" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#210d10" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#120608" stop-opacity="0.9" />
                </linearGradient>
                <linearGradient id="grad-browser" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0e1a22" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#081016" stop-opacity="0.9" />
                </linearGradient>
                <linearGradient id="grad-server" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#0e1f16" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#08120c" stop-opacity="0.9" />
                </linearGradient>
              </defs>

              <!-- SWIMLANE 1: UNTRUSTED ORIGIN -->
              <rect x="30" y="30" width="300" height="550" rx="10" fill="url(#grad-attacker)" stroke="#ff5252" stroke-width="1.5" stroke-dasharray="4 2" />
              <rect x="30" y="30" width="300" height="42" rx="10" fill="#2d1014" />
              <text x="50" y="56" fill="#ff7070" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700" letter-spacing="1">UNTRUSTED ORIGIN CONTEXT</text>
              <text x="50" y="95" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="16" font-weight="600">Attacker Domain (evil.com)</text>

              <!-- Attacker Sub-card: Staged Payload -->
              <g class="interactive-node" data-inspect-title="Attacker Form Payload" data-inspect-desc="Attacker page hosts a form pre-populated with victim funds transfer parameters. Executes automatically via JavaScript onload.">
                <rect x="50" y="120" width="260" height="150" rx="8" fill="#180a0c" stroke="#542025" stroke-width="1" />
                <text x="65" y="145" fill="#ff8552" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600">&lt;form action="https://bank.com/transfer"&gt;</text>
                <text x="65" y="170" fill="#c4d2c5" font-family="'JetBrains Mono', monospace" font-size="11">&lt;input name="recipient" value="hacker" /&gt;</text>
                <text x="65" y="190" fill="#c4d2c5" font-family="'JetBrains Mono', monospace" font-size="11">&lt;input name="amount" value="5000" /&gt;</text>
                <text x="65" y="215" fill="#ffd8a8" font-family="'JetBrains Mono', monospace" font-size="10">&lt;script&gt;document.forms[0].submit()&lt;/script&gt;</text>
                <rect x="65" y="235" width="230" height="22" rx="4" fill="#381318" />
                <text x="75" y="250" fill="#ff9999" font-family="'JetBrains Mono', monospace" font-size="10">⚡ Automated Cross-Origin Dispatch</text>
              </g>

              <!-- SWIMLANE 2: VICTIM BROWSER RUNTIME -->
              <rect x="390" y="30" width="320" height="550" rx="10" fill="url(#grad-browser)" stroke="#4dd8d8" stroke-width="1.5" />
              <rect x="390" y="30" width="320" height="42" rx="10" fill="#132630" />
              <text x="410" y="56" fill="#4dd8d8" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700" letter-spacing="1">VICTIM CLIENT (CONFUSED DEPUTY)</text>
              <text x="410" y="95" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="16" font-weight="600">Browser Network Engine</text>

              <!-- Cookie Jar Container -->
              <g class="interactive-node" data-inspect-title="Browser Cookie Jar" data-inspect-desc="The browser holds valid session cookies for bank.com. Because Same-Origin Policy permits cross-origin writes, cookies with SameSite=None are automatically injected.">
                <rect x="410" y="120" width="280" height="150" rx="8" fill="#0c171e" stroke="#1d3d4d" stroke-width="1" />
                <text x="425" y="145" fill="#63a4fc" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">🍪 Cookie Jar Storage</text>
                <text x="425" y="170" fill="#c4d2c5" font-family="'JetBrains Mono', monospace" font-size="11">Domain: <tspan fill="#f0f7f1">bank.com</tspan> | Path: <tspan fill="#f0f7f1">/</tspan></text>
                <text x="425" y="195" fill="#52dc88" font-family="'JetBrains Mono', monospace" font-size="11">Set-Cookie: session_id=sess_user_9921</text>
                <text x="425" y="218" fill="#f5b041" font-family="'JetBrains Mono', monospace" font-size="11">SameSite=None (or Lax GET)</text>
                <rect x="425" y="235" width="250" height="22" rx="4" fill="#1b3644" />
                <text x="435" y="250" fill="#7ae4ff" font-family="'JetBrains Mono', monospace" font-size="10">✔ Ambient Authority Automatically Attached</text>
              </g>

              <!-- TRUST BOUNDARY WALL (Between Attacker & Browser) -->
              <line x1="360" y1="30" x2="360" y2="580" stroke="#ff5252" stroke-width="2" stroke-dasharray="6 4" />
              <rect x="345" y="290" width="30" height="180" rx="4" fill="#361014" stroke="#ff5252" />
              <text x="358" y="320" fill="#ff8552" font-family="'JetBrains Mono', monospace" font-size="10" font-weight="700" writing-mode="vertical-rl" letter-spacing="2">TRUST BOUNDARY</text>

              <!-- SWIMLANE 3: TARGET APPLICATION SERVER -->
              <rect x="770" y="30" width="260" height="550" rx="10" fill="url(#grad-server)" stroke="#52dc88" stroke-width="1.5" />
              <rect x="770" y="30" width="260" height="42" rx="10" fill="#132b1d" />
              <text x="790" y="56" fill="#52dc88" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700" letter-spacing="1">TARGET SINK (bank.com)</text>
              <text x="790" y="95" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="16" font-weight="600">Banking Application Server</text>

              <!-- Server Validation Box -->
              <g class="interactive-node" data-inspect-title="Server State Mutation Sink" data-inspect-desc="The server validates that session_id belongs to an authenticated user, but fails to check Origin, Referer, or Anti-CSRF nonces. It commits the transaction blindly.">
                <rect x="790" y="120" width="220" height="150" rx="8" fill="#0a180f" stroke="#1c4728" stroke-width="1" />
                <text x="805" y="145" fill="#52dc88" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">⚙️ Endpoint: /api/transfer</text>
                <text x="805" y="170" fill="#b7f35d" font-family="'JetBrains Mono', monospace" font-size="11">1. Session Validated: TRUE ✔</text>
                <text x="805" y="195" fill="#ff5252" font-family="'JetBrains Mono', monospace" font-size="11">2. Origin Checked: FALSE ❌</text>
                <text x="805" y="218" fill="#ff5252" font-family="'JetBrains Mono', monospace" font-size="11">3. CSRF Token Checked: FALSE ❌</text>
                <rect x="805" y="235" width="190" height="22" rx="4" fill="#3b1518" />
                <text x="815" y="250" fill="#ff8080" font-family="'JetBrains Mono', monospace" font-size="10">💥 State Mutation Committed!</text>
              </g>

              <!-- PROTOCOL ARROWS -->
              <!-- Arrow 1: Attacker -> Browser -->
              <path d="M 310 195 L 400 195" stroke="#ff5252" stroke-width="2.5" marker-end="url(#arrow-red)" />
              <rect x="325" y="172" width="65" height="18" rx="3" fill="#2d0f12" />
              <text x="330" y="185" fill="#ff7373" font-family="'JetBrains Mono', monospace" font-size="9">1. Dispatches</text>

              <!-- Arrow 2: Browser -> Bank Server -->
              <path d="M 690 195 L 780 195" stroke="#f5b041" stroke-width="2.5" marker-end="url(#arrow-cyan)" />
              <rect x="700" y="165" width="70" height="26" rx="3" fill="#2e210a" />
              <text x="705" y="178" fill="#ffd175" font-family="'JetBrains Mono', monospace" font-size="9">2. POST /transfer</text>
              <text x="705" y="188" fill="#ffd175" font-family="'JetBrains Mono', monospace" font-size="8">+ Cookie: sess</text>

              <!-- Arrow 3: Server -> Browser (Response) -->
              <path d="M 790 380 L 700 380" stroke="#52dc88" stroke-width="2" stroke-dasharray="4 3" marker-end="url(#arrow-green)" />
              <rect x="715" y="360" width="60" height="18" rx="3" fill="#102b1b" />
              <text x="720" y="373" fill="#75ffaa" font-family="'JetBrains Mono', monospace" font-size="9">3. HTTP 200</text>

              <!-- SOP Shield Blocking Attacker Read -->
              <rect x="410" y="340" width="280" height="100" rx="8" fill="#132219" stroke="#52dc88" stroke-width="1" />
              <text x="425" y="365" fill="#52dc88" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">🛡️ Same-Origin Policy (SOP) Block</text>
              <text x="425" y="390" fill="#c4d2c5" font-family="'Outfit', sans-serif" font-size="12">Browser prevents evil.com from reading response body.</text>
              <text x="425" y="415" fill="#ff8552" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600">CRITICAL: Server mutation is ALREADY committed!</text>

              <line x1="410" y1="390" x2="330" y2="390" stroke="#ff5252" stroke-width="2" stroke-dasharray="3 3" />
              <circle cx="370" cy="390" r="10" fill="#ff5252" />
              <text x="367" y="394" fill="#fff" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">✕</text>
            </svg>
          </div>

          <!-- ================= DIAGRAM 2: NORMAL VS VULNERABLE ================= -->
          <div class="svg-flow-card" id="svg_diag_2">
            <svg viewBox="0 0 1060 620" class="arch-svg-canvas" xmlns="http://www.w3.org/2000/svg">
              <!-- TRACK 1: NORMAL INTRA-ORIGIN (SAFE) -->
              <rect x="30" y="30" width="480" height="550" rx="10" fill="#0a1710" stroke="#52dc88" stroke-width="1.5" />
              <rect x="30" y="30" width="480" height="42" rx="10" fill="#122e1e" />
              <text x="50" y="56" fill="#52dc88" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">✔ 1. NORMAL INTRA-ORIGIN INTERACTION (SAFE)</text>

              <!-- Normal Step 1 -->
              <g class="interactive-node" data-inspect-title="Legitimate Page Navigation" data-inspect-desc="User navigates directly to legitimate banking form. Context is same-origin.">
                <rect x="50" y="90" width="440" height="75" rx="6" fill="#102418" stroke="#255436" stroke-width="1" />
                <circle cx="75" cy="127" r="14" fill="#52dc88" />
                <text x="71" y="132" fill="#000" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">1</text>
                <text x="100" y="118" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">User navigates to https://bank.com/transfer</text>
                <text x="100" y="140" fill="#8bc99c" font-family="'JetBrains Mono', monospace" font-size="11">Frontend renders form containing unique Anti-CSRF Token Nonce</text>
              </g>

              <path d="M 270 165 L 270 195" stroke="#52dc88" stroke-width="2" marker-end="url(#arrow-green)" />

              <!-- Normal Step 2 -->
              <g class="interactive-node" data-inspect-title="User Dispatches Form with Nonce" data-inspect-desc="Request includes both session cookie AND the unpredictable anti-CSRF token read from the DOM.">
                <rect x="50" y="205" width="440" height="85" rx="6" fill="#102418" stroke="#255436" stroke-width="1" />
                <circle cx="75" cy="247" r="14" fill="#52dc88" />
                <text x="71" y="252" fill="#000" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">2</text>
                <text x="100" y="230" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">Dispatches POST /api/transfer</text>
                <text x="100" y="252" fill="#8bc99c" font-family="'JetBrains Mono', monospace" font-size="11">Origin: bank.com | Cookie: session_id=xyz</text>
                <text x="100" y="272" fill="#b7f35d" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">X-CSRF-Token: 9f8a2e1d7c3b (Validated Cryptographic Nonce)</text>
              </g>

              <path d="M 270 290 L 270 320" stroke="#52dc88" stroke-width="2" marker-end="url(#arrow-green)" />

              <!-- Normal Step 3 -->
              <g class="interactive-node" data-inspect-title="Server Dual Validation" data-inspect-desc="Server validates authentication (session cookie) AND intent provenance (CSRF token matches session).">
                <rect x="50" y="330" width="440" height="85" rx="6" fill="#102418" stroke="#255436" stroke-width="1" />
                <circle cx="75" cy="372" r="14" fill="#52dc88" />
                <text x="71" y="377" fill="#000" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">3</text>
                <text x="100" y="355" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">Bank Server Validates Dual Predicate</text>
                <text x="100" y="377" fill="#8bc99c" font-family="'JetBrains Mono', monospace" font-size="11">1. Session Active ✔ | 2. Token Matches Session ✔</text>
                <text x="100" y="397" fill="#7ae4ff" font-family="'JetBrains Mono', monospace" font-size="11">Intent Provenance Verified &rarr; Safe to Mutate State</text>
              </g>

              <path d="M 270 415 L 270 445" stroke="#52dc88" stroke-width="2" marker-end="url(#arrow-green)" />

              <!-- Normal Outcome -->
              <rect x="50" y="455" width="440" height="90" rx="6" fill="#133822" stroke="#52dc88" stroke-width="1.5" />
              <text x="70" y="490" fill="#b7f35d" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="700">✅ INTENDED STATE MUTATION COMMITTED</text>
              <text x="70" y="515" fill="#e0f8e5" font-family="'Outfit', sans-serif" font-size="13">Transaction executed with verified user intentionality and authorization.</text>

              <!-- TRACK 2: VULNERABLE CROSS-ORIGIN (CSRF) -->
              <rect x="550" y="30" width="480" height="550" rx="10" fill="#18090b" stroke="#ff5252" stroke-width="1.5" />
              <rect x="550" y="30" width="480" height="42" rx="10" fill="#301014" />
              <text x="570" y="56" fill="#ff7070" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">💥 2. CROSS-ORIGIN FORCED EXECUTION (VULNERABLE)</text>

              <!-- Vulnerable Step 1 -->
              <g class="interactive-node" data-inspect-title="Victim Visits Malicious Site" data-inspect-desc="Victim visits evil.com while holding an active session cookie for bank.com in their browser cookie jar.">
                <rect x="570" y="90" width="440" height="75" rx="6" fill="#290e12" stroke="#591e25" stroke-width="1" />
                <circle cx="595" cy="127" r="14" fill="#ff5252" />
                <text x="591" y="132" fill="#fff" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">1</text>
                <text x="620" y="118" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">Victim visits external site https://evil.com/prize</text>
                <text x="620" y="140" fill="#ff9999" font-family="'JetBrains Mono', monospace" font-size="11">Hidden form auto-submits targeting https://bank.com/transfer</text>
              </g>

              <path d="M 790 165 L 790 195" stroke="#ff5252" stroke-width="2" marker-end="url(#arrow-red)" />

              <!-- Vulnerable Step 2 -->
              <g class="interactive-node" data-inspect-title="Confused Deputy Cookie Attachment" data-inspect-desc="Browser dispatches request with ambient cookie but lacks the unpredictable token.">
                <rect x="570" y="205" width="440" height="85" rx="6" fill="#290e12" stroke="#591e25" stroke-width="1" />
                <circle cx="595" cy="247" r="14" fill="#ff5252" />
                <text x="591" y="252" fill="#fff" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">2</text>
                <text x="620" y="230" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">Browser Network Engine (Confused Deputy)</text>
                <text x="620" y="252" fill="#ff9999" font-family="'JetBrains Mono', monospace" font-size="11">Origin: evil.com | Cookie: session_id=xyz (AMBIENT ATTACHMENT)</text>
                <text x="620" y="272" fill="#ff5252" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">❌ NO Anti-CSRF Token Present!</text>
              </g>

              <path d="M 790 290 L 790 320" stroke="#ff5252" stroke-width="2" marker-end="url(#arrow-red)" />

              <!-- Vulnerable Step 3 -->
              <g class="interactive-node" data-inspect-title="Server Omission of Provenance" data-inspect-desc="Server validates session_id but omits intent check, conflating identity with provenance.">
                <rect x="570" y="330" width="440" height="85" rx="6" fill="#290e12" stroke="#591e25" stroke-width="1" />
                <circle cx="595" cy="372" r="14" fill="#ff5252" />
                <text x="591" y="377" fill="#fff" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">3</text>
                <text x="620" y="355" fill="#f0f7f1" font-family="'Outfit', sans-serif" font-size="14" font-weight="600">Vulnerable Bank Server Flaw</text>
                <text x="620" y="377" fill="#ff9999" font-family="'JetBrains Mono', monospace" font-size="11">1. Session Active: TRUE ✔ | 2. Origin/Intent Check: OMITTED ❌</text>
                <text x="620" y="397" fill="#ffb8ad" font-family="'JetBrains Mono', monospace" font-size="11">Conflates WHO holds session with WHAT originated request</text>
              </g>

              <path d="M 790 415 L 790 445" stroke="#ff5252" stroke-width="2" marker-end="url(#arrow-red)" />

              <!-- Vulnerable Outcome -->
              <rect x="570" y="455" width="440" height="90" rx="6" fill="#421217" stroke="#ff5252" stroke-width="1.5" />
              <text x="590" y="490" fill="#ff8552" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="700">💥 UNAUTHORIZED STATE MUTATION EXECUTED!</text>
              <text x="590" y="515" fill="#ffe0e0" font-family="'Outfit', sans-serif" font-size="13">Funds transferred to attacker without victim consent or knowledge.</text>
            </svg>
          </div>

          <!-- ================= DIAGRAM 3: CAUSAL PIPELINE ================= -->
          <div class="svg-flow-card" id="svg_diag_3">
            <svg viewBox="0 0 1060 580" class="arch-svg-canvas" xmlns="http://www.w3.org/2000/svg">
              <!-- 6-STAGE PIPELINE (ROW 1: 1 -> 2 -> 3) -->
              <!-- Stage 1 -->
              <g class="interactive-node" data-inspect-title="Stage 1: Payload Staging" data-inspect-desc="Attacker prepares exploit page on evil.com with target parameters pre-filled.">
                <rect x="40" y="60" width="280" height="180" rx="8" fill="#141a29" stroke="#63a4fc" stroke-width="1.5" />
                <rect x="40" y="60" width="280" height="32" rx="8" fill="#1d273d" />
                <text x="55" y="82" fill="#63a4fc" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">STAGE 01 &bull; EXTERNAL CONTEXT</text>
