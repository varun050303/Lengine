<script define:vars={{ diagrams, visualConfigs: VISUAL_DIAGRAMS_CONFIG, mermaidDiagrams: MERMAID_DIAGRAMS }}>
  // Data Indexing
  const diagMap = new Map();
  diagrams.forEach(d => diagMap.set(d.id, d));

  const configMap = new Map();
  visualConfigs.forEach(vc => configMap.set(vc.id, vc));

  let currentDiagId = 'diag_1';
  let currentViewMode = 'svg'; // 'svg' | 'mermaid' | 'ascii'
  let currentZoom = 1.0;
  let mermaidLoaded = false;

  // DOM Handles
  const activeDiagramTag = document.getElementById('activeDiagramTag');
  const activeDiagramTitle = document.getElementById('activeDiagramTitle');
  const activeDiagramSub = document.getElementById('activeDiagramSub');
  const activeTakeawayText = document.getElementById('activeTakeawayText');

  const svgViewport = document.getElementById('svgViewport');
  const mermaidViewport = document.getElementById('mermaidViewport');
  const asciiViewport = document.getElementById('asciiViewport');
  const svgZoomTarget = document.getElementById('svgZoomTarget');

  const btnModeSvg = document.getElementById('btnModeSvg');
  const btnModeMermaid = document.getElementById('btnModeMermaid');
  const btnModeAscii = document.getElementById('btnModeAscii');

  const btnZoomIn = document.getElementById('btnZoomIn');
  const btnZoomOut = document.getElementById('btnZoomOut');
  const btnZoomReset = document.getElementById('btnZoomReset');
  const zoomLevelText = document.getElementById('zoomLevelText');

  const btnCopyDiagramSpec = document.getElementById('btnCopyDiagramSpec');
  const asciiRawContent = document.getElementById('asciiRawContent');
  const asciiTerminalFilename = document.getElementById('asciiTerminalFilename');
  const mermaidRenderHost = document.getElementById('mermaidRenderHost');
  const mermaidSourceCode = document.getElementById('mermaidSourceCode');

  const hudElementTitle = document.getElementById('hudElementTitle');
  const hudElementDesc = document.getElementById('hudElementDesc');

  // Mermaid Renderer using dynamic import or global
  async function renderMermaid() {
    if (!mermaidRenderHost) return;
    const mermaidCode = mermaidDiagrams[currentDiagId] || 'graph TD; Error[Diagram not found];';
    if (mermaidSourceCode) mermaidSourceCode.textContent = mermaidCode;

    try {
      // Dynamic import
      const mermaidModule = await import('mermaid');
      const mermaid = mermaidModule.default;
      if (!mermaidLoaded) {
        mermaid.initialize({
          startOnLoad: false,
          theme: 'dark',
          themeVariables: {
            darkMode: true,
            background: '#0a0e0c',
            primaryColor: '#18231c',
            primaryBorderColor: '#52dc88',
            primaryTextColor: '#f0f7f1',
            lineColor: '#4dd8d8',
            secondaryColor: '#151e18',
            tertiaryColor: '#111713',
            fontFamily: 'JetBrains Mono, monospace'
          }
        });
        mermaidLoaded = true;
      }
      const uniqueId = `mermaid_${currentDiagId}_${Date.now()}`;
      const { svg } = await mermaid.render(uniqueId, mermaidCode);
      mermaidRenderHost.innerHTML = svg;
    } catch (err) {
      console.error('Mermaid render error:', err);
      mermaidRenderHost.innerHTML = `<div style="color: #ff7070; padding: 20px;">Mermaid Render Notice: ${err.message}</div>`;
    }
  }

  function setZoom(newZoom) {
    currentZoom = Math.min(Math.max(newZoom, 0.5), 2.2);
    if (svgZoomTarget) {
      svgZoomTarget.style.transform = `scale(${currentZoom})`;
    }
    if (zoomLevelText) {
      zoomLevelText.textContent = `${Math.round(currentZoom * 100)}%`;
    }
  }

  btnZoomIn.addEventListener('click', () => setZoom(currentZoom + 0.15));
  btnZoomOut.addEventListener('click', () => setZoom(currentZoom - 0.15));
  btnZoomReset.addEventListener('click', () => setZoom(1.0));

  function setViewMode(mode) {
    currentViewMode = mode;
    [btnModeSvg, btnModeMermaid, btnModeAscii].forEach(b => b.classList.remove('active'));
    [svgViewport, mermaidViewport, asciiViewport].forEach(vp => vp.style.display = 'none');

    if (mode === 'svg') {
      btnModeSvg.classList.add('active');
      svgViewport.style.display = 'flex';
    } else if (mode === 'mermaid') {
      btnModeMermaid.classList.add('active');
      mermaidViewport.style.display = 'flex';
      renderMermaid();
    } else if (mode === 'ascii') {
      btnModeAscii.classList.add('active');
      asciiViewport.style.display = 'flex';
    }
  }

  btnModeSvg.addEventListener('click', () => setViewMode('svg'));
  btnModeMermaid.addEventListener('click', () => setViewMode('mermaid'));
  btnModeAscii.addEventListener('click', () => setViewMode('ascii'));

  function selectDiagram(id) {
    currentDiagId = id;
    const config = configMap.get(id);
    const diag = diagMap.get(id);

    // Update sidebar active buttons
    document.querySelectorAll('.diag-select-btn').forEach(btn => {
      if (btn.getAttribute('data-diagram-id') === id) {
        btn.classList.add('active');
      } else {
        btn.classList.remove('active');
      }
    });

    if (config) {
      activeDiagramTag.textContent = `DIAGRAM 0${config.number} • ${config.title.toUpperCase()}`;
      activeDiagramTitle.textContent = `${config.number}. ${config.title}`;
      activeDiagramSub.textContent = config.subtitle;
      activeTakeawayText.textContent = config.keyTakeaway;
    }

    if (diag) {
      asciiRawContent.textContent = diag.content;
      asciiTerminalFilename.textContent = diag.filename;
    }

    // Toggle SVG visual flow card
    document.querySelectorAll('.svg-flow-card').forEach(card => {
      if (card.id === `svg_${id}`) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });

    // If currently on mermaid mode, re-render
    if (currentViewMode === 'mermaid') {
      renderMermaid();
    }
  }

  // Sidebar clicks
  document.querySelectorAll('.diag-select-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-diagram-id');
      if (id) selectDiagram(id);
    });
  });

  // Interactive Node Click -> HUD Update
  document.querySelectorAll('.interactive-node').forEach(node => {
    node.addEventListener('click', (e) => {
      e.stopPropagation();
      const title = node.getAttribute('data-inspect-title') || 'Architectural Component';
      const desc = node.getAttribute('data-inspect-desc') || 'Component verified against canonical security model.';
      hudElementTitle.textContent = title;
      hudElementDesc.textContent = desc;
    });
  });

  // Copy Spec button
  btnCopyDiagramSpec.addEventListener('click', () => {
    const textToCopy = currentViewMode === 'mermaid' 
      ? (mermaidDiagrams[currentDiagId] || '') 
      : asciiRawContent.textContent;
    navigator.clipboard.writeText(textToCopy);
    const origHtml = btnCopyDiagramSpec.innerHTML;
    btnCopyDiagramSpec.innerHTML = `<span>✔</span> Copied!`;
    setTimeout(() => { btnCopyDiagramSpec.innerHTML = origHtml; }, 1600);
  });
</script>
