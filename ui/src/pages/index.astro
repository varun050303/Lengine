---
import '../styles/global.css';
import { getCsrfFullKnowledge } from '../utils/csrf-knowledge';
import VisualDiagramsViewer from '../components/VisualDiagramsViewer.astro';

const knowledge = getCsrfFullKnowledge();
const { topicJson, mindmap, diagrams, crosslinks, mechanismFamily, concepts, claims, sources } = knowledge;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lengine | Security Researcher Second Brain - {topicJson.display_name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg-main: #0a0e0c;
        --bg-panel: #111713;
        --bg-panel-elevated: #151e18;
        --bg-card: #18231c;
        --border-color: #243428;
        --border-hover: #364d3c;
        --border-focus: #52dc88;
        --text-bright: #f0f7f1;
        --text-main: #c4d2c5;
        --text-dim: #798d7c;
        
        --color-root: #b7f35d;
        --color-observe: #4dd8d8;
        --color-ask: #63a4fc;
        --color-hypothesize: #b890fa;
        --color-test: #f5b041;
        --color-evidence: #52dc88;
        --color-reconstruct: #f56d91;
        --color-capability: #ff8552;
        --color-transfer: #38e1b0;

        --font-mono: 'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;
        --font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background-color: var(--bg-main);
        color: var(--text-main);
        font-family: var(--font-sans);
        overflow: hidden;
      }

      .app-shell {
        display: flex;
        flex-direction: column;
        width: 100vw;
        height: 100vh;
      }

      /* ================= TOP NAVIGATION BAR ================= */
      .top-navbar {
        height: 58px;
        background: var(--bg-panel);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        flex-shrink: 0;
        z-index: 50;
      }

      .nav-left {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .brand-badge {
        background: var(--color-root);
        color: #0d130e;
        font-family: var(--font-mono);
        font-weight: 800;
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 4px;
        letter-spacing: 0.05em;
      }

      .topic-badge {
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 700;
        color: var(--text-bright);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .topic-mechanism-tag {
        font-size: 10px;
        font-weight: 500;
        color: var(--color-observe);
        background: rgba(77, 216, 216, 0.1);
        border: 1px solid rgba(77, 216, 216, 0.25);
        padding: 2px 7px;
        border-radius: 3px;
      }

      /* VIEW MODES TABS */
      .nav-modes {
        display: flex;
        align-items: center;
        gap: 4px;
        background: var(--bg-main);
        padding: 3px;
        border-radius: 6px;
        border: 1px solid var(--border-color);
      }

      .mode-tab-btn {
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 4px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.18s ease;
      }

      .mode-tab-btn:hover {
        color: var(--text-bright);
        background: rgba(255, 255, 255, 0.04);
      }

      .mode-tab-btn.active {
        color: #0c120e;
        background: var(--color-root);
        font-weight: 700;
      }

      .nav-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .search-box {
        display: flex;
        align-items: center;
        background: var(--bg-main);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 6px 12px;
        width: 260px;
        transition: border-color 0.2s;
      }

      .search-box:focus-within {
        border-color: var(--color-root);
      }

      .search-box input {
        background: transparent;
        border: none;
        color: var(--text-bright);
        font-family: var(--font-mono);
        font-size: 11px;
        outline: none;
        width: 100%;
      }

      .icon-btn {
        background: var(--bg-main);
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        padding: 6px 10px;
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 11px;
        cursor: pointer;
        transition: all 0.2s;
      }

      .icon-btn:hover {
        color: var(--text-bright);
        border-color: var(--border-hover);
      }

      /* ================= WORKSPACE VIEWPORTS ================= */
      .workspace-viewport {
        flex: 1;
        display: none;
        overflow: hidden;
        position: relative;
      }

      .workspace-viewport.active-view {
        display: flex;
      }

      /* ================= 1. MINDMAP VIEWPORT ================= */
      #viewMindmap {
        display: none;
      }
      #viewMindmap.active-view {
        display: flex;
      }

      .canvas-area {
        flex: 1;
        position: relative;
        overflow: auto;
        padding: 60px 80px;
        background: 
          radial-gradient(circle at 50% 50%, rgba(21, 30, 24, 0.45) 0%, rgba(10, 14, 12, 1) 100%),
          linear-gradient(to right, rgba(36, 52, 40, 0.2) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(36, 52, 40, 0.2) 1px, transparent 1px);
        background-size: 100% 100%, 36px 36px, 36px 36px;
      }

      .canvas-toolbar {
        position: absolute;
        top: 20px;
        left: 24px;
        z-index: 20;
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(17, 23, 19, 0.85);
        backdrop-filter: blur(8px);
        border: 1px solid var(--border-color);
        padding: 4px 8px;
        border-radius: 6px;
      }

      .mindmap-flow {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 50px;
        min-width: 1400px;
        margin: 0 auto;
        position: relative;
      }

      #connector-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      .connector-path {
        fill: none;
        stroke: #243428;
        stroke-width: 2px;
        transition: stroke 0.3s ease;
      }

      .connector-path.active {
        stroke: var(--color-root);
        stroke-width: 2.5px;
      }

      /* CORE ROOT NODE */
      .core-node {
        z-index: 2;
        background: linear-gradient(135deg, #18281d 0%, #111b14 100%);
        border: 2px solid var(--color-root);
        box-shadow: 0 0 30px rgba(183, 243, 93, 0.12), 0 10px 24px rgba(0, 0, 0, 0.5);
        border-radius: 10px;
        padding: 20px 32px;
        text-align: center;
        max-width: 520px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .core-node:hover {
        transform: translateY(-2px);
        box-shadow: 0 0 40px rgba(183, 243, 93, 0.25);
      }

      .core-node.selected {
        box-shadow: 0 0 0 3px rgba(183, 243, 93, 0.3), 0 12px 32px rgba(0, 0, 0, 0.7);
      }

      .core-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-root);
        letter-spacing: -0.01em;
      }

      .core-subtitle {
        font-size: 13px;
        color: var(--text-dim);
        margin-top: 6px;
        font-family: var(--font-mono);
      }

      /* 8 PILLARS LAYOUT (SPACIOUS 4x2 OR HORIZONTAL ROW) */
      .pillars-container {
        display: grid;
        grid-template-columns: repeat(4, 330px);
        gap: 32px 36px;
        z-index: 2;
      }

      .pillar-card-wrapper {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .node-card {
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 14px 18px;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
        user-select: none;
      }

      .node-card:hover {
        border-color: var(--border-hover);
        transform: translateY(-2px);
        background: var(--bg-panel-elevated);
      }

      .node-card.selected {
        border-color: var(--node-accent, var(--color-root));
        box-shadow: 0 0 0 2px rgba(183, 243, 93, 0.2), 0 8px 24px rgba(0, 0, 0, 0.6);
        background: var(--bg-panel-elevated);
      }

      .node-card.dimmed {
        opacity: 0.2;
        filter: grayscale(0.8);
      }

      .pillar-head-card {
        border-left-width: 5px;
      }

      .pillar-head-card.p-OBSERVE { --node-accent: var(--color-observe); border-left-color: var(--color-observe); }
      .pillar-head-card.p-ASK { --node-accent: var(--color-ask); border-left-color: var(--color-ask); }
      .pillar-head-card.p-HYPOTHESIZE { --node-accent: var(--color-hypothesize); border-left-color: var(--color-hypothesize); }
      .pillar-head-card.p-TEST { --node-accent: var(--color-test); border-left-color: var(--color-test); }
      .pillar-head-card.p-EVIDENCE { --node-accent: var(--color-evidence); border-left-color: var(--color-evidence); }
      .pillar-head-card.p-RECONSTRUCT { --node-accent: var(--color-reconstruct); border-left-color: var(--color-reconstruct); }
      .pillar-head-card.p-CAPABILITY { --node-accent: var(--color-capability); border-left-color: var(--color-capability); }
      .pillar-head-card.p-TRANSFER { --node-accent: var(--color-transfer); border-left-color: var(--color-transfer); }

      .pillar-step-num {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--node-accent, var(--color-root));
        margin-bottom: 4px;
      }

      .pillar-head-title {
        font-size: 15px;
        font-weight: 700;
        color: var(--text-bright);
      }

      .pillar-head-tagline {
        font-size: 12px;
        color: var(--text-dim);
        margin-top: 4px;
        line-height: 1.35;
      }

      /* SUB-NODES CONTAINER */
      .sub-nodes-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-left: 14px;
        border-left: 1px dashed var(--border-color);
        margin-left: 10px;
      }

      .sub-node-card {
        padding: 10px 14px;
        background: var(--bg-card);
      }

      .sub-node-card .sub-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-main);
      }

      /* RIGHT INSPECTOR (SECOND BRAIN FIELD NOTEBOOK) */
      .inspector-drawer {
        width: 480px;
        background: var(--bg-panel);
        border-left: 1px solid var(--border-color);
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        z-index: 20;
        box-shadow: -6px 0 25px rgba(0, 0, 0, 0.45);
        transition: width 0.25s ease, transform 0.25s ease;
      }

      .inspector-drawer.collapsed {
        width: 0;
        transform: translateX(100%);
        overflow: hidden;
      }

      .drawer-header {
        padding: 20px 24px;
        border-bottom: 1px solid var(--border-color);
        background: var(--bg-panel-elevated);
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .drawer-top-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .drawer-category-badge {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-root);
        padding: 3px 8px;
        background: rgba(183, 243, 93, 0.1);
        border-radius: 4px;
      }

      .drawer-close-btn {
        background: transparent;
        border: none;
        color: var(--text-dim);
        font-size: 18px;
        cursor: pointer;
        padding: 0 4px;
      }

      .drawer-close-btn:hover {
        color: var(--text-bright);
      }

      .drawer-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-bright);
        margin: 0;
        letter-spacing: -0.01em;
      }

      .drawer-tagline {
        font-size: 13px;
        color: var(--text-dim);
        margin: 0;
        line-height: 1.45;
      }

      .drawer-scroll-body {
        padding: 24px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .section-heading {
        font-family: var(--font-mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-dim);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 10px;
      }

      .section-heading::before {
        content: '';
        display: inline-block;
        width: 4px;
        height: 12px;
        background: var(--color-root);
        border-radius: 1px;
      }

      .recon-check-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .recon-check-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-main);
        background: var(--bg-card);
        padding: 8px 12px;
        border-radius: 6px;
        border: 1px solid rgba(255, 255, 255, 0.03);
      }

      .recon-check-item input[type="checkbox"] {
        margin-top: 3px;
        accent-color: var(--color-root);
        cursor: pointer;
      }

      .code-view-card {
        background: #080c09;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        overflow: hidden;
      }

      .code-view-header {
        padding: 8px 14px;
        background: rgba(255, 255, 255, 0.03);
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-dim);
      }

      .copy-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-dim);
        font-size: 10px;
        padding: 2px 6px;
        border-radius: 3px;
        cursor: pointer;
      }

      .copy-btn:hover {
        color: var(--color-root);
        border-color: var(--color-root);
      }

      .code-view-body {
        padding: 14px;
        margin: 0;
        font-family: var(--font-mono);
        font-size: 11.5px;
        line-height: 1.6;
        color: #d1ddd2;
        overflow-x: auto;
        white-space: pre-wrap;
      }

      .experiment-box {
        background: rgba(245, 176, 65, 0.06);
        border: 1px solid rgba(245, 176, 65, 0.3);
        border-radius: 8px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .exp-line {
        font-size: 12.5px;
        line-height: 1.5;
      }

      .exp-label {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--color-test);
        margin-right: 8px;
      }

      .pitfall-banner {
        background: rgba(237, 143, 129, 0.07);
        border-left: 4px solid #ed8f81;
        padding: 12px 16px;
        border-radius: 0 8px 8px 0;
      }

      .pitfall-banner .section-heading {
        color: #ed8f81;
      }
      .pitfall-banner .section-heading::before {
        background: #ed8f81;
      }

      .action-diagram-jump {
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        color: var(--color-observe);
        font-family: var(--font-mono);
        font-size: 11px;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 6px;
        transition: all 0.2s;
      }

      .action-diagram-jump:hover {
        border-color: var(--color-observe);
        background: rgba(77, 216, 216, 0.08);
      }

      /* ================= 2. ARCHITECTURE DIAGRAMS VIEWPORT ================= */
      #viewDiagrams {
        display: none;
        flex-direction: row;
        width: 100%;
        height: 100%;
      }
      #viewDiagrams.active-view {
        display: flex;
      }

      .diagrams-sidebar {
        width: 320px;
        background: var(--bg-panel);
        border-right: 1px solid var(--border-color);
        overflow-y: auto;
        padding: 20px 16px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        flex-shrink: 0;
      }

      .diagram-item-btn {
        text-align: left;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        padding: 12px 14px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s;
      }

      .diagram-item-btn:hover {
        background: var(--bg-panel-elevated);
        border-color: var(--border-hover);
      }

      .diagram-item-btn.active {
        background: var(--bg-panel-elevated);
        border-color: var(--color-observe);
        box-shadow: 0 0 0 1px var(--color-observe);
      }

      .diagram-item-btn .diag-idx {
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-observe);
        margin-bottom: 2px;
        display: block;
      }

      .diagram-item-btn .diag-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-bright);
      }

      .diagram-content-viewer {
        flex: 1;
        overflow-y: auto;
        padding: 36px 48px;
        background: #080c09;
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .diagram-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 16px;
      }

      .diagram-header-bar h2 {
        margin: 0;
        font-size: 18px;
        color: var(--color-observe);
        font-family: var(--font-mono);
      }

      .diagram-pre {
        margin: 0;
        padding: 24px;
        background: #0d120e;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        line-height: 1.45;
        color: #c9e2cb;
        overflow-x: auto;
        white-space: pre;
      }

      /* ================= 3. KNOWLEDGE & CROSSLINKS VIEWPORT ================= */
      #viewCrosslinks {
        display: none;
        padding: 40px 60px;
        overflow-y: auto;
        flex-direction: column;
        gap: 36px;
        width: 100%;
        height: 100%;
      }
      #viewCrosslinks.active-view {
        display: flex;
      }

      .crosslinks-hero {
        max-width: 960px;
      }

      .crosslinks-hero h2 {
        font-size: 26px;
        color: var(--text-bright);
        margin: 0 0 10px 0;
      }

      .crosslinks-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        max-width: 1200px;
      }

      .knowledge-card {
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .knowledge-card-tag {
        font-family: var(--font-mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--color-hypothesize);
      }

      .knowledge-card-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--text-bright);
        margin: 0;
      }

      .knowledge-card-desc {
        font-size: 13px;
        color: var(--text-dim);
        line-height: 1.55;
        margin: 0;
      }

      .rel-badge {
        font-family: var(--font-mono);
        font-size: 10px;
        padding: 2px 8px;
        border-radius: 3px;
        background: rgba(183, 243, 93, 0.12);
        color: var(--color-root);
        align-self: flex-start;
      }

      /* ================= 4. DEFENSES & VARIANCE VIEWPORT ================= */
      #viewDefenses {
        display: none;
        padding: 40px 60px;
        overflow-y: auto;
        flex-direction: column;
        gap: 36px;
        width: 100%;
        height: 100%;
      }
      #viewDefenses.active-view {
        display: flex;
      }

      .sim-interactive-box {
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 24px;
        max-width: 1000px;
        display: flex;
        flex-direction: column;
        gap: 20px;
      }

      .sim-control-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
      }

      .sim-control-item label {
        display: block;
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-dim);
        margin-bottom: 6px;
      }

      .sim-control-item select {
        width: 100%;
        background: var(--bg-main);
        border: 1px solid var(--border-color);
        color: var(--text-bright);
        padding: 8px 10px;
        border-radius: 6px;
        font-family: var(--font-mono);
        font-size: 12px;
        outline: none;
      }

      .sim-result-banner {
        padding: 16px 20px;
        border-radius: 8px;
        font-family: var(--font-mono);
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .sim-result-banner.vulnerable {
        background: rgba(237, 143, 129, 0.12);
        border: 1px solid #ed8f81;
        color: #ffa599;
      }

      .sim-result-banner.protected {
        background: rgba(82, 220, 136, 0.12);
        border: 1px solid #52dc88;
        color: #79f7a7;
      }

      /* ================= 5. CLAIMS & SOURCES VIEWPORT ================= */
      #viewClaims {
        display: none;
        padding: 40px 60px;
        overflow-y: auto;
        flex-direction: column;
        gap: 30px;
        width: 100%;
        height: 100%;
      }
      #viewClaims.active-view {
        display: flex;
      }

      .claims-table {
        width: 100%;
        max-width: 1200px;
        border-collapse: collapse;
        font-size: 13px;
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
      }

      .claims-table th, .claims-table td {
        padding: 14px 18px;
        text-align: left;
        border-bottom: 1px solid var(--border-color);
      }

      .claims-table th {
        background: var(--bg-panel-elevated);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--text-dim);
        text-transform: uppercase;
        letter-spacing: 0.08em;
      }

      .claims-table code {
        font-family: var(--font-mono);
        color: var(--color-root);
        font-size: 11.5px;
      }
    </style>
  </head>
  <body>
    <div class="app-shell">
      <!-- TOP NAVIGATION BAR -->
      <header class="top-navbar">
        <div class="nav-left">
          <span class="brand-badge">LENGINE</span>
          <div class="topic-badge">
            <span>{topicJson.display_name}</span>
            <span class="topic-mechanism-tag">{topicJson.mechanism_family}</span>
          </div>
        </div>

        <!-- VIEW MODE SELECTOR -->
        <nav class="nav-modes">
          <button class="mode-tab-btn active" data-view="viewMindmap" id="btnModeMindmap">
            🧠 Reasoning Mindmap
          </button>
          <button class="mode-tab-btn" data-view="viewDiagrams" id="btnModeDiagrams">
            📐 Architecture Diagrams ({diagrams.length})
          </button>
          <button class="mode-tab-btn" data-view="viewCrosslinks" id="btnModeCrosslinks">
            🌐 Topic Interconnections ({crosslinks.length})
          </button>
          <button class="mode-tab-btn" data-view="viewDefenses" id="btnModeDefenses">
            🛡️ Defenses & SameSite Sim
          </button>
          <button class="mode-tab-btn" data-view="viewClaims" id="btnModeClaims">
            📜 Claims Registry ({claims.length})
          </button>
        </nav>

        <div class="nav-right">
          <div class="search-box">
            <input type="text" id="globalSearch" placeholder="Filter questions, signals, tests..." autocomplete="off" />
          </div>
          <button class="icon-btn" id="btnToggleDrawer" title="Toggle Inspector Panel">⇄ Drawer</button>
        </div>
      </header>

      <!-- ================= 1. MINDMAP VIEWPORT ================= -->
      <section class="workspace-viewport active-view" id="viewMindmap">
        <div class="canvas-area" id="canvasArea">
          <div class="canvas-toolbar">
            <button class="icon-btn" id="btnZoomIn">+</button>
            <button class="icon-btn" id="btnZoomOut">−</button>
            <button class="icon-btn" id="btnZoomReset">Reset 100%</button>
          </div>

          <div class="mindmap-flow" id="mindmapFlow">
            <svg id="connector-svg"></svg>

            <!-- CORE ROOT -->
            <div class="core-node selected" id="node-root" data-id="root">
              <div class="core-title">{topicJson.display_name}</div>
              <div class="core-subtitle">Origin-Context Confusion & Ambient Authority Investigation Core</div>
            </div>

            <!-- 8 PILLARS ROW -->
            <div class="pillars-container" id="pillarsContainer">
              <!-- Pillar 1: OBSERVE -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-OBSERVE" data-id="obs_request">
                  <div class="pillar-step-num">1. OBSERVE</div>
                  <div class="pillar-head-title">What can I see?</div>
                  <div class="pillar-head-tagline">Raw HTTP headers, cookies, state changes</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="obs_request">
                    <div class="sub-title">Request & Method</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="obs_credentials">
                    <div class="sub-title">Credential Mechanism</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="obs_provenance">
                    <div class="sub-title">Origin & Referer</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="obs_state_delta">
                    <div class="sub-title">State Mutation</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 2: ASK -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-ASK" data-id="ask_control">
                  <div class="pillar-step-num">2. ASK</div>
                  <div class="pillar-head-title">What should I ask?</div>
                  <div class="pillar-head-tagline">Control, authority, trust boundaries</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="ask_control">
                    <div class="sub-title">Who Controls Input?</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="ask_authority">
                    <div class="sub-title">Who Supplies Authority?</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="ask_boundary">
                    <div class="sub-title">Boundary Crossed</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 3: HYPOTHESIZE -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-HYPOTHESIZE" data-id="hyp_competing">
                  <div class="pillar-step-num">3. HYPOTHESIZE</div>
                  <div class="pillar-head-title">What explanations compete?</div>
                  <div class="pillar-head-tagline">Formulate competing models (H1 vs H2)</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="hyp_competing">
                    <div class="sub-title">Competing Hypotheses</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 4: TEST -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-TEST" data-id="test_cross_origin">
                  <div class="pillar-step-num">4. TEST</div>
                  <div class="pillar-head-title">Which test separates?</div>
                  <div class="pillar-head-tagline">Smallest discriminating experiments</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="test_cross_origin">
                    <div class="sub-title">Cross-Origin Dispatch</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="test_strip_origin">
                    <div class="sub-title">Header Stripping</div>
                  </div>
                  <div class="node-card sub-node-card" data-id="test_token_differential">
                    <div class="sub-title">Token Differentials</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 5: EVIDENCE -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-EVIDENCE" data-id="ev_discipline">
                  <div class="pillar-step-num">5. EVIDENCE</div>
                  <div class="pillar-head-title">How do I calibrate?</div>
                  <div class="pillar-head-tagline">Observation vs Inference separation</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="ev_discipline">
                    <div class="sub-title">Obs vs Inference</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 6: RECONSTRUCT -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-RECONSTRUCT" data-id="recon_causal">
                  <div class="pillar-step-num">6. RECONSTRUCT</div>
                  <div class="pillar-head-title">What is the mechanism?</div>
                  <div class="pillar-head-tagline">Causal sequence from trigger to sink</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="recon_causal">
                    <div class="sub-title">5-Stage Causal Chain</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 7: CAPABILITY -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-CAPABILITY" data-id="cap_primitive">
                  <div class="pillar-step-num">7. CAPABILITY</div>
                  <div class="pillar-head-title">What can be caused?</div>
                  <div class="pillar-head-tagline">Primitive vs Downstream Impact</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="cap_primitive">
                    <div class="sub-title">Primitive vs Impact</div>
                  </div>
                </div>
              </div>

              <!-- Pillar 8: TRANSFER -->
              <div class="pillar-card-wrapper">
                <div class="node-card pillar-head-card p-TRANSFER" data-id="transfer_variants">
                  <div class="pillar-step-num">8. TRANSFER</div>
                  <div class="pillar-head-title">Where else does it apply?</div>
                  <div class="pillar-head-tagline">WebSockets, GraphQL, WebViews</div>
                </div>
                <div class="sub-nodes-group">
                  <div class="node-card sub-node-card" data-id="transfer_variants">
                    <div class="sub-title">Cross-Domain Variants</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT INSPECTOR (RESEARCHER FIELD NOTEBOOK) -->
        <aside class="inspector-drawer" id="inspectorDrawer">
          <div class="drawer-header">
            <div class="drawer-top-row">
              <span class="drawer-category-badge" id="inspCategory">ROOT REASONING</span>
              <button class="drawer-close-btn" id="btnCloseDrawer" title="Collapse Panel">✕</button>
            </div>
            <h3 class="drawer-title" id="inspTitle">CSRF Investigation Core</h3>
            <p class="drawer-tagline" id="inspTagline">How an experienced researcher determines whether an endpoint is vulnerable to cross-site dispatch.</p>
          </div>

          <div class="drawer-scroll-body">
            <!-- THINK ABOUT -->
            <div class="section-block">
              <span class="section-heading">How an Expert Thinks About This</span>
              <ul class="think-list" id="inspThinkList" style="padding-left: 18px; margin: 0; line-height: 1.6; font-size: 13px;"></ul>
            </div>

            <!-- DIAGNOSTIC QUESTIONS CHECKLIST -->
            <div class="section-block">
              <span class="section-heading">Recon Diagnostic Checklist</span>
              <div class="recon-check-list" id="inspChecklist"></div>
            </div>

            <!-- RAW EVIDENCE CODE VIEWER -->
            <div class="section-block">
              <span class="section-heading">Raw Evidence to Inspect</span>
              <div id="inspEvidenceContainer" style="display: flex; flex-direction: column; gap: 10px;"></div>
            </div>

            <!-- DISCRIMINATING EXPERIMENT -->
            <div class="section-block" id="blockExperiment" style="display: none;">
              <span class="section-heading">Discriminating Experiment</span>
              <div class="experiment-box">
                <div class="exp-line"><span class="exp-label">Action:</span> <span id="expActionText"></span></div>
                <div class="exp-line"><span class="exp-label">If True:</span> <span id="expIfTrueText"></span></div>
                <div class="exp-line"><span class="exp-label">If False:</span> <span id="expIfFalseText"></span></div>
                <div class="exp-line"><span class="exp-label">Rationale:</span> <span id="expWhyText"></span></div>
              </div>
            </div>

            <!-- PITFALLS -->
            <div class="pitfall-banner">
              <span class="section-heading">Cognitive Traps & Pitfalls</span>
              <ul id="inspPitfallsList" style="padding-left: 18px; margin: 0; line-height: 1.55; font-size: 12.5px; color: #f2a79b;"></ul>
            </div>

            <!-- LINK TO ARCHITECTURE DIAGRAM -->
            <div class="section-block">
              <span class="section-heading">Structural Architecture Diagram</span>
              <button class="action-diagram-jump" id="btnJumpDiagram">
                <span>📐 Open Related Architecture Diagram</span>
                <span>➔</span>
              </button>
            </div>
          </div>
        </aside>
      </section>

      <!-- ================= 2. ARCHITECTURE DIAGRAMS VIEWPORT ================= -->
      <section class="workspace-viewport" id="viewDiagrams">
        <VisualDiagramsViewer diagrams={diagrams} />
      </section>

      <!-- ================= 3. KNOWLEDGE & CROSSLINKS VIEWPORT ================= -->
      <section class="workspace-viewport" id="viewCrosslinks">
        <div class="crosslinks-hero">
          <h2>Topic Interconnections & Attack Chaining</h2>
          <p style="color: var(--text-dim); font-size: 14px; line-height: 1.6; margin: 0;">
            Vulnerabilities rarely exist in isolation. In real engagements, mechanisms cross-pollinate: XSS dissolves token defenses, CORS determines read capability, and ambient authority transfers to WebSocket handshakes.
          </p>
        </div>

        <div class="crosslinks-grid">
          <!-- Crosslink: XSS -> CSRF -->
          <div class="knowledge-card">
            <span class="knowledge-card-tag">Upstream Enabler</span>
            <h3 class="knowledge-card-title">XSS ➔ CSRF Token Dissolution</h3>
            <span class="rel-badge">Relationship: enables</span>
            <p class="knowledge-card-desc">
              Cross-Site Scripting (XSS) fundamentally eliminates anti-CSRF token protections. Because the attacker's script executes within the authentic same-origin context, it can read anti-CSRF synchronizer nonces directly from the DOM or issue same-origin Fetch requests.
            </p>
          </div>

          <!-- Crosslink: CSRF <-> CORS -->
          <div class="knowledge-card">
            <span class="knowledge-card-tag">Complementary Axis</span>
            <h3 class="knowledge-card-title">CSRF ⟷ CORS Misconfiguration</h3>
            <span class="rel-badge">Relationship: complementary</span>
            <p class="knowledge-card-desc">
              CSRF enables <b>unauthorized state changes (writes)</b> across origins without reading responses. CORS misconfigurations (<code>Access-Control-Allow-Origin: *</code> with credentials) enable <b>unauthorized data theft (reads)</b> across origins. Together they grant full read/write control.
            </p>
          </div>

          <!-- Crosslink: CSRF <-> Clickjacking -->
          <div class="knowledge-card">
            <span class="knowledge-card-tag">Shared Mechanism</span>
            <h3 class="knowledge-card-title">CSRF ⟷ Clickjacking</h3>
            <span class="rel-badge">Relationship: shared_mechanism</span>
            <p class="knowledge-card-desc">
              Both attacks exploit the victim's ambient authenticated browser session. Where CSRF automates request dispatch behind the scenes, Clickjacking uses visual deception (transparent iframes) to trick the victim's physical clicks into triggering the state mutation.
            </p>
          </div>

          <!-- Crosslink: WebSockets / CSWSH -->
          <div class="knowledge-card">
            <span class="knowledge-card-tag">Protocol Transfer</span>
            <h3 class="knowledge-card-title">CSRF ➔ Cross-Site WebSockets (CSWSH)</h3>
            <span class="rel-badge">Relationship: protocol_transfer</span>
            <p class="knowledge-card-desc">
              WebSocket HTTP 101 handshakes transmit ambient session cookies without being bound by the Same-Origin Policy. If the WebSocket server fails to validate the Origin header, cross-site attackers gain bidirectional full-duplex socket control.
            </p>
          </div>

          <!-- Mechanism Family -->
          <div class="knowledge-card" style="border-color: var(--color-observe); background: rgba(77, 216, 216, 0.04);">
            <span class="knowledge-card-tag" style="color: var(--color-observe);">Shared Causal Mechanism</span>
            <h3 class="knowledge-card-title">{mechanismFamily?.display_name || 'Origin-Context Confusion'}</h3>
            <span class="rel-badge">Family: {mechanismFamily?.id}</span>
            <p class="knowledge-card-desc">
              {mechanismFamily?.core_principle}
            </p>
          </div>

          <!-- Core Concepts -->
          <div class="knowledge-card" style="border-color: var(--color-root); background: rgba(183, 243, 93, 0.04);">
            <span class="knowledge-card-tag" style="color: var(--color-root);">Foundational Concept</span>
            <h3 class="knowledge-card-title">Ambient Credentials</h3>
            <span class="rel-badge">ID: concept.ambient-credentials</span>
            <p class="knowledge-card-desc">
              The client runtime automatically and implicitly attaches authority (session cookies) based on destination domain matching, rather than requiring programmatic user-intent verification.
            </p>
          </div>
        </div>
      </section>

      <!-- ================= 4. DEFENSES & SAMESITE SIM VIEWPORT ================= -->
      <section class="workspace-viewport" id="viewDefenses">
        <div class="crosslinks-hero">
          <h2>Interactive SameSite Cookie & Defense Simulator</h2>
          <p style="color: var(--text-dim); font-size: 14px; line-height: 1.6; margin: 0;">
            Test whether an outbound cross-site HTTP request will transmit session cookies under modern browser policies (RFC 6265bis & Chromium Lax rules).
          </p>
        </div>

        <div class="sim-interactive-box">
          <div class="sim-control-grid">
            <div class="sim-control-item">
              <label>1. Origin Context:</label>
              <select id="simOrigin">
                <option value="cross">Cross-Site (https://evil.com)</option>
                <option value="same">Same-Site (https://app.local)</option>
              </select>
            </div>

            <div class="sim-control-item">
              <label>2. Cookie SameSite Flag:</label>
              <select id="simSameSite">
                <option value="None">SameSite=None; Secure</option>
                <option value="Lax" selected>SameSite=Lax (or Default Unset)</option>
                <option value="Strict">SameSite=Strict</option>
              </select>
            </div>

            <div class="sim-control-item">
              <label>3. Request Type:</label>
              <select id="simReqType">
                <option value="subresource">Subresource (Form POST, fetch, iframe)</option>
                <option value="navigation">Top-Level Navigation (&lt;a&gt;, 302 redirect)</option>
              </select>
            </div>

            <div class="sim-control-item">
              <label>4. HTTP Method:</label>
              <select id="simMethod">
                <option value="POST">POST (State-Changing)</option>
                <option value="GET">GET (Safe Method)</option>
              </select>
            </div>
          </div>

          <div class="sim-result-banner vulnerable" id="simBanner">
            <div>
              <strong id="simStatusHeading">COOKIE TRANSMITTED [EXPLOITABLE CSRF]</strong>
              <p style="margin: 4px 0 0 0; font-size: 11.5px; opacity: 0.9;" id="simStatusExplanation">
                SameSite=None cookies are transmitted on all cross-site requests.
              </p>
            </div>
            <span style="font-size: 24px;" id="simStatusIcon">⚠️</span>
          </div>
        </div>

        <!-- 4 CANONICAL DEFENSES -->
        <div class="crosslinks-grid">
          {topicJson.defenses?.map((def: any) => (
            <div class="knowledge-card">
              <span class="knowledge-card-tag" style="color: var(--color-evidence);">Defense Layer</span>
              <h3 class="knowledge-card-title">{def.name}</h3>
              <p class="knowledge-card-desc">{def.description || def.mechanism}</p>
              {def.bypass_risks && (
                <div style="font-size: 11px; color: var(--color-test); background: rgba(245, 176, 65, 0.08); padding: 6px 10px; border-radius: 4px;">
                  <b>Bypass Risks:</b> {Array.isArray(def.bypass_risks) ? def.bypass_risks.join(', ') : def.bypass_risks}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- ================= 5. CLAIMS & SOURCES VIEWPORT ================= -->
      <section class="workspace-viewport" id="viewClaims">
        <div class="crosslinks-hero">
          <h2>Atomic Claims & Evidence Provenance Registry</h2>
          <p style="color: var(--text-dim); font-size: 14px; line-height: 1.6; margin: 0;">
            All factual assertions in Lengine are anchored in verified technical specifications (RFCs, W3C standards, and browser engine implementations).
          </p>
        </div>

        <table class="claims-table">
          <thead>
            <tr>
              <th style="width: 200px;">Claim ID</th>
              <th>Technical Assertion Statement</th>
              <th style="width: 130px;">Type</th>
              <th style="width: 100px;">Sources</th>
            </tr>
          </thead>
          <tbody>
            {claims.map(c => (
              <tr>
                <td><code>{c.claim_id}</code></td>
                <td>{c.statement}</td>
                <td><span class="rel-badge">{c.type}</span></td>
                <td>
                  {c.sources?.map((s: string) => (
                    <span style="font-family: var(--font-mono); font-size: 11px; color: var(--color-observe); margin-right: 4px;">[{s}]</span>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>

        <!-- SOURCES REGISTRY -->
        <div style="margin-top: 10px;">
          <h3 style="font-size: 18px; color: var(--text-bright); margin-bottom: 12px;">Verified Evidence Sources</h3>
          <div class="crosslinks-grid">
            {sources.map(s => (
              <div class="knowledge-card" style="padding: 14px 18px;">
                <span class="knowledge-card-tag" style="color: var(--color-root);">[{s.id}] Tier {s.tier} Source</span>
                <h4 style="margin: 0; font-size: 14px; color: var(--text-bright);">{s.title}</h4>
                <a href={s.url} target="_blank" style="font-family: var(--font-mono); font-size: 11px; color: var(--color-ask); text-decoration: none; word-break: break-all;">
                  {s.url}
                </a>
                <p style="margin: 0; font-size: 12px; color: var(--text-dim);">{s.claim}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>

    <!-- CLIENT CONTROLLER SCRIPT -->
    <script define:vars={{ mindmapNodes: mindmap.nodes, diagrams }}>
      // 1. Data Maps
      const nodeMap = new Map();
      mindmapNodes.forEach(n => nodeMap.set(n.id, n));

      const diagMap = new Map();
      diagrams.forEach(d => diagMap.set(d.id, d));

      let activeNodeId = 'root';
      let zoomLevel = 1.0;

      // 2. View Mode Navigation
      const modeButtons = document.querySelectorAll('.mode-tab-btn');
      const viewports = document.querySelectorAll('.workspace-viewport');

      modeButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          modeButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const targetViewId = btn.getAttribute('data-view');
          viewports.forEach(vp => {
            if (vp.id === targetViewId) {
              vp.classList.add('active-view');
            } else {
              vp.classList.remove('active-view');
            }
          });

          if (targetViewId === 'viewMindmap') {
            setTimeout(drawConnectors, 50);
          }
        });
      });

      // 3. Inspector Drawer Elements
      const drawer = document.getElementById('inspectorDrawer');
      const btnCloseDrawer = document.getElementById('btnCloseDrawer');
      const btnToggleDrawer = document.getElementById('btnToggleDrawer');
      const inspCategory = document.getElementById('inspCategory');
      const inspTitle = document.getElementById('inspTitle');
      const inspTagline = document.getElementById('inspTagline');
      const inspThinkList = document.getElementById('inspThinkList');
      const inspChecklist = document.getElementById('inspChecklist');
      const inspEvidenceContainer = document.getElementById('inspEvidenceContainer');
      const blockExperiment = document.getElementById('blockExperiment');
      const expActionText = document.getElementById('expActionText');
      const expIfTrueText = document.getElementById('expIfTrueText');
      const expIfFalseText = document.getElementById('expIfFalseText');
      const expWhyText = document.getElementById('expWhyText');
      const inspPitfallsList = document.getElementById('inspPitfallsList');
      const btnJumpDiagram = document.getElementById('btnJumpDiagram');

      function selectNode(id) {
        const node = nodeMap.get(id);
        if (!node) return;

        activeNodeId = id;
        drawer.classList.remove('collapsed');

        // Highlight selected node
        document.querySelectorAll('.node-card, .core-node').forEach(el => el.classList.remove('selected'));
        const activeEl = document.querySelector(`[data-id="${id}"]`);
        if (activeEl) activeEl.classList.add('selected');

        // Header info
        inspCategory.textContent = node.category;
        inspTitle.textContent = node.label;
        inspTagline.textContent = node.tagline;

        // Think about
        inspThinkList.innerHTML = '';
        node.thinkAbout.forEach(t => {
          const li = document.createElement('li');
          li.textContent = t;
          inspThinkList.appendChild(li);
        });

        // Diagnostic questions with interactive checkboxes
        inspChecklist.innerHTML = '';
        node.diagnosticQuestions.forEach((q, idx) => {
          const item = document.createElement('div');
          item.className = 'recon-check-item';
          item.innerHTML = `
            <input type="checkbox" id="chk_${id}_${idx}" />
            <label for="chk_${id}_${idx}" style="cursor: pointer;">${q}</label>
          `;
          inspChecklist.appendChild(item);
        });

        // Evidence snippets
        inspEvidenceContainer.innerHTML = '';
        node.evidenceToInspect.forEach(ev => {
          const card = document.createElement('div');
          card.className = 'code-view-card';
          card.innerHTML = `
            <div class="code-view-header">
              <span>${ev.title} (${ev.type})</span>
              <button class="copy-btn">Copy</button>
            </div>
            <pre class="code-view-body">${ev.snippet}</pre>
          `;
          const copyBtn = card.querySelector('.copy-btn');
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(ev.snippet);
            copyBtn.textContent = 'Copied!';
            setTimeout(() => { copyBtn.textContent = 'Copy'; }, 1500);
          });
          inspEvidenceContainer.appendChild(card);
        });

        // Experiment
        if (node.discriminatingExperiment) {
          blockExperiment.style.display = 'flex';
          expActionText.textContent = node.discriminatingExperiment.action;
          expIfTrueText.textContent = node.discriminatingExperiment.predictionIfTrue;
          expIfFalseText.textContent = node.discriminatingExperiment.predictionIfFalse;
          expWhyText.textContent = node.discriminatingExperiment.whyInformative;
        } else {
          blockExperiment.style.display = 'none';
        }

        // Pitfalls
        inspPitfallsList.innerHTML = '';
        node.pitfalls.forEach(p => {
          const li = document.createElement('li');
          li.textContent = p;
          inspPitfallsList.appendChild(li);
        });
      }

      // Drawer Toggle
      btnCloseDrawer.addEventListener('click', () => drawer.classList.add('collapsed'));
      btnToggleDrawer.addEventListener('click', () => drawer.classList.toggle('collapsed'));

      // Node Clicks
      document.querySelectorAll('.node-card, .core-node').forEach(card => {
        card.addEventListener('click', () => {
          const id = card.getAttribute('data-id');
          if (id) selectNode(id);
        });
      });

      // Jump to diagram from inspector
      btnJumpDiagram.addEventListener('click', () => {
        const btnDiagMode = document.getElementById('btnModeDiagrams');
        if (btnDiagMode) btnDiagMode.click();
        const activeNode = activeNodeId ? nodeMap.get(activeNodeId) : null;
        if (activeNode && activeNode.diagramRef) {
          const targetBtn = document.querySelector(`.diag-select-btn[data-diagram-id="${activeNode.diagramRef}"]`);
          if (targetBtn) targetBtn.click();
        }
      });

      // 5. SameSite Cookie Decision Tree Simulator
      const simOrigin = document.getElementById('simOrigin');
      const simSameSite = document.getElementById('simSameSite');
      const simReqType = document.getElementById('simReqType');
      const simMethod = document.getElementById('simMethod');
      const simBanner = document.getElementById('simBanner');
      const simStatusHeading = document.getElementById('simStatusHeading');
      const simStatusExplanation = document.getElementById('simStatusExplanation');
      const simStatusIcon = document.getElementById('simStatusIcon');

      function evaluateSameSiteSim() {
        const origin = simOrigin.value;
        const sameSite = simSameSite.value;
        const reqType = simReqType.value;
        const method = simMethod.value;

        if (origin === 'same') {
          simBanner.className = 'sim-result-banner vulnerable';
          simStatusHeading.textContent = 'COOKIE TRANSMITTED [SAME-ORIGIN DISPATCH]';
          simStatusExplanation.textContent = 'Requests within the same site always include cookies regardless of SameSite attribute.';
          simStatusIcon.textContent = '✅';
          return;
        }

        // Cross-Site logic
        if (sameSite === 'Strict') {
          simBanner.className = 'sim-result-banner protected';
          simStatusHeading.textContent = 'COOKIE WITHHELD [PROTECTED BY SAMESITE=STRICT]';
          simStatusExplanation.textContent = 'SameSite=Strict cookies are withheld on all cross-site requests, including top-level links.';
          simStatusIcon.textContent = '🛡️';
        } else if (sameSite === 'None') {
          simBanner.className = 'sim-result-banner vulnerable';
          simStatusHeading.textContent = 'COOKIE TRANSMITTED [VULNERABLE: SAMESITE=NONE]';
          simStatusExplanation.textContent = 'SameSite=None cookies are transmitted on all cross-site requests (subresources and forms).';
          simStatusIcon.textContent = '⚠️';
        } else {
          // SameSite=Lax
          if (reqType === 'subresource') {
            simBanner.className = 'sim-result-banner protected';
            simStatusHeading.textContent = 'COOKIE WITHHELD [PROTECTED BY SAMESITE=LAX]';
            simStatusExplanation.textContent = 'Lax cookies are withheld on cross-site subresources (form POSTs, fetch, XHR).';
            simStatusIcon.textContent = '🛡️';
          } else {
            // Navigation
            if (method === 'GET') {
              simBanner.className = 'sim-result-banner vulnerable';
              simStatusHeading.textContent = 'COOKIE TRANSMITTED [TOP-LEVEL GET NAVIGATION EXCEPTION]';
              simStatusExplanation.textContent = 'Per RFC 6265bis, SameSite=Lax cookies ARE transmitted on top-level GET navigations (vulnerable if action triggers on GET!).';
              simStatusIcon.textContent = '⚠️';
            } else {
              simBanner.className = 'sim-result-banner protected';
              simStatusHeading.textContent = 'COOKIE WITHHELD [LAX POST RESTRICTION]';
              simStatusExplanation.textContent = 'Top-level POST navigations withhold Lax cookies unless within the Chromium 120-second Lax window.';
              simStatusIcon.textContent = '🛡️';
            }
          }
        }
      }

      [simOrigin, simSameSite, simReqType, simMethod].forEach(el => {
        el.addEventListener('change', evaluateSameSiteSim);
      });

      // 6. SVG Connector Curve Drawing
      function drawConnectors() {
        const svg = document.getElementById('connector-svg');
        const flow = document.getElementById('mindmapFlow');
        if (!svg || !flow) return;

        svg.innerHTML = '';
        const flowRect = flow.getBoundingClientRect();

        const rootEl = document.getElementById('node-root');
        if (!rootEl) return;
        const rootRect = rootEl.getBoundingClientRect();
        const rootX = rootRect.left + rootRect.width / 2 - flowRect.left;
        const rootY = rootRect.bottom - flowRect.top;

        document.querySelectorAll('.pillar-head-card').forEach(pillar => {
          const pRect = pillar.getBoundingClientRect();
          const pX = pRect.left + pRect.width / 2 - flowRect.left;
          const pY = pRect.top - flowRect.top;

          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          const midY = (rootY + pY) / 2;
          const d = `M ${rootX} ${rootY} C ${rootX} ${midY}, ${pX} ${midY}, ${pX} ${pY}`;
          path.setAttribute('d', d);
          path.setAttribute('class', 'connector-path');
          svg.appendChild(path);
        });
      }

      window.addEventListener('resize', drawConnectors);
      setTimeout(drawConnectors, 80);

      // 7. Search Filter
      const searchInput = document.getElementById('globalSearch');
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        if (!q) {
          document.querySelectorAll('.node-card, .core-node').forEach(c => c.classList.remove('dimmed'));
          return;
        }

        document.querySelectorAll('.node-card, .core-node').forEach(card => {
          const id = card.getAttribute('data-id');
          const node = nodeMap.get(id);
          if (!node) return;

          const haystack = [
            node.label,
            node.tagline,
            ...node.thinkAbout,
            ...node.diagnosticQuestions,
            ...node.pitfalls,
            ...node.evidenceToInspect.map(ev => ev.snippet + ' ' + ev.title)
          ].join(' ').toLowerCase();

          if (haystack.includes(q)) {
            card.classList.remove('dimmed');
          } else {
            card.classList.add('dimmed');
          }
        });
      });

      // 8. Zoom Controls
      const mindmapFlowEl = document.getElementById('mindmapFlow');
      document.getElementById('btnZoomIn').addEventListener('click', () => {
        zoomLevel = Math.min(zoomLevel + 0.15, 1.8);
        mindmapFlowEl.style.transform = `scale(${zoomLevel})`;
        mindmapFlowEl.style.transformOrigin = 'top center';
        drawConnectors();
      });
      document.getElementById('btnZoomOut').addEventListener('click', () => {
        zoomLevel = Math.max(zoomLevel - 0.15, 0.5);
        mindmapFlowEl.style.transform = `scale(${zoomLevel})`;
        mindmapFlowEl.style.transformOrigin = 'top center';
        drawConnectors();
      });
      document.getElementById('btnZoomReset').addEventListener('click', () => {
        zoomLevel = 1.0;
        mindmapFlowEl.style.transform = `scale(1)`;
        drawConnectors();
      });

      // Initial Selection
      selectNode('root');
      evaluateSameSiteSim();
    </script>
  </body>
</html>
