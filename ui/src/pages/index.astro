---
import '../styles/workbench.css';
import { getCsrfFullKnowledge } from '../utils/csrf-knowledge';
import VisualDiagramsViewer from '../components/VisualDiagramsViewer.astro';

const knowledge = getCsrfFullKnowledge();
const { topicJson, mindmap, diagrams, claims, sources, mechanismFamily } = knowledge;

const order = ['ROOT', 'OBSERVE', 'ASK', 'HYPOTHESIZE', 'TEST', 'EVIDENCE', 'RECONSTRUCT', 'CAPABILITY', 'TRANSFER'];
const nodes = mindmap.nodes || [];
const byCat: Record<string, typeof nodes> = {};
for (const n of nodes) {
  const c = n.category || 'ROOT';
  if (!byCat[c]) byCat[c] = [];
  byCat[c].push(n);
}
const groups = order.filter((c) => byCat[c]?.length).map((c) => ({ cat: c, nodes: byCat[c] }));
const initial = nodes.find((n) => n.category === 'ROOT') || nodes[0];
const mechLabel = (topicJson.mechanism_family || '').replace(/^mechanism\./, '');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lengine · {topicJson.display_name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="wb">
      <header class="wb-top">
        <div class="wb-mark">LENGINE</div>
        <div class="wb-topic">
          {topicJson.display_name}
          <span>{mechLabel}</span>
        </div>
        <nav class="wb-tabs" role="tablist">
          <button type="button" class="wb-tab active" data-pane="map" role="tab">Map</button>
          <button type="button" class="wb-tab" data-pane="diagrams" role="tab">Diagrams</button>
          <button type="button" class="wb-tab" data-pane="claims" role="tab">Claims</button>
        </nav>
      </header>

      <div class="wb-body">
        <div id="pane-map" class="wb-pane active" style="display:contents">
          <aside class="wb-rail" aria-label="Investigation stages">
            <div class="wb-rail-label">Stages</div>
            {groups.map((g) => (
              <div class="wb-stage-group" data-cat={g.cat}>
                <h3>{g.cat}</h3>
                {g.nodes.map((n) => (
                  <button
                    type="button"
                    class:list={['wb-node-btn', { active: n.id === initial?.id }]}
                    data-node-id={n.id}
                  >
                    {n.label}
                  </button>
                ))}
              </div>
            ))}
          </aside>

          <main class="wb-focus">
            <div class="wb-focus-inner" id="focus">
              {initial ? (
                <>
                  <p class="wb-kicker" id="f-cat">{initial.category}</p>
                  <h1 class="wb-title" id="f-title">{initial.label}</h1>
                  <p class="wb-tagline" id="f-tagline">{initial.tagline}</p>

                  <section class="wb-block" id="f-think-wrap">
                    <h2>Think about</h2>
                    <ul id="f-think">
                      {initial.thinkAbout?.map((t) => <li>{t}</li>)}
                    </ul>
                  </section>

                  <section class="wb-block" id="f-q-wrap">
                    <h2>Diagnostic questions</h2>
                    <ul id="f-q">
                      {initial.diagnosticQuestions?.map((t) => <li>{t}</li>)}
                    </ul>
                  </section>

                  <section class="wb-block" id="f-ev-wrap">
                    <h2>Evidence to inspect</h2>
                    <div id="f-ev">
                      {initial.evidenceToInspect?.map((e) => (
                        <div style="margin-bottom:12px">
                          <div style="font-size:12px;color:var(--wb-dim);margin-bottom:6px">{e.title}</div>
                          <pre class="wb-snippet">{e.snippet}</pre>
                        </div>
                      ))}
                    </div>
                  </section>

                  <section class="wb-block wb-exp" id="f-exp-wrap" style={initial.discriminatingExperiment ? '' : 'display:none'}>
                    <h2>Discriminating experiment</h2>
                    <dl id="f-exp">
                      {initial.discriminatingExperiment && (
                        <>
                          <div><dt>Action</dt><dd>{initial.discriminatingExperiment.action}</dd></div>
                          <div><dt>If true</dt><dd>{initial.discriminatingExperiment.predictionIfTrue}</dd></div>
                          <div><dt>If false</dt><dd>{initial.discriminatingExperiment.predictionIfFalse}</dd></div>
                          <div><dt>Why informative</dt><dd>{initial.discriminatingExperiment.whyInformative}</dd></div>
                        </>
                      )}
                    </dl>
                  </section>

                  <section class="wb-block wb-pitfall" id="f-pit-wrap">
                    <h2>Pitfalls</h2>
                    <ul id="f-pit">
                      {initial.pitfalls?.map((t) => <li>{t}</li>)}
                    </ul>
                  </section>
                </>
              ) : (
                <p class="wb-empty">No mindmap nodes loaded.</p>
              )}
            </div>
          </main>
        </div>

        <div id="pane-diagrams" class="wb-pane">
          <VisualDiagramsViewer diagrams={diagrams} />
        </div>

        <div id="pane-claims" class="wb-pane">
          <div class="wb-focus-inner">
            <p class="wb-kicker">Provenance</p>
            <h1 class="wb-title">Claims & sources</h1>
            <p class="wb-tagline">Atomic assertions with evidence tiers — not a quiz.</p>
            {(claims || []).map((c: any) => (
              <section class="wb-block">
                <h2>{c.claim_id || c.id}</h2>
                <p style="margin:0 0 8px;line-height:1.55">{c.statement || c.claim}</p>
                {c.evidence_tier && (
                  <p style="margin:0;font-family:var(--wb-mono);font-size:11px;color:var(--wb-cyan)">
                    tier: {c.evidence_tier}
                  </p>
                )}
              </section>
            ))}
            {(sources || []).length > 0 && (
              <section class="wb-block">
                <h2>Sources</h2>
                <ul>
                  {sources.map((s: any) => (
                    <li>{s.title || s.name || s.url}</li>
                  ))}
                </ul>
              </section>
            )}
            {mechanismFamily && (
              <section class="wb-block">
                <h2>Mechanism family</h2>
                <p style="margin:0">{mechanismFamily.display_name || mechanismFamily.id}</p>
                {mechanismFamily.core_principle && (
                  <p style="margin:10px 0 0;color:var(--wb-dim)">{mechanismFamily.core_principle}</p>
                )}
              </section>
            )}
          </div>
        </div>
      </div>
    </div>

    <script define:vars={{ nodes }}>
      const byId = Object.fromEntries(nodes.map((n) => [n.id, n]));

      function list(items) {
        return (items || []).map((t) => '<li>' + escapeHtml(t) + '</li>').join('');
      }
      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, '&')
          .replace(/</g, '<')
          .replace(/>/g, '>')
          .replace(/"/g, '"');
      }

      function render(node) {
        if (!node) return;
        document.getElementById('f-cat').textContent = node.category || '';
        document.getElementById('f-title').textContent = node.label || '';
        document.getElementById('f-tagline').textContent = node.tagline || '';
        document.getElementById('f-think').innerHTML = list(node.thinkAbout);
        document.getElementById('f-q').innerHTML = list(node.diagnosticQuestions);
        document.getElementById('f-pit').innerHTML = list(node.pitfalls);

        const ev = document.getElementById('f-ev');
        ev.innerHTML = (node.evidenceToInspect || [])
          .map(
            (e) =>
              '<div style="margin-bottom:12px"><div style="font-size:12px;color:var(--wb-dim);margin-bottom:6px">' +
              escapeHtml(e.title) +
              '</div><pre class="wb-snippet">' +
              escapeHtml(e.snippet) +
              '</pre></div>'
          )
          .join('');

        const expWrap = document.getElementById('f-exp-wrap');
        const exp = node.discriminatingExperiment;
        if (exp) {
          expWrap.style.display = '';
          document.getElementById('f-exp').innerHTML =
            '<div><dt>Action</dt><dd>' + escapeHtml(exp.action) + '</dd></div>' +
            '<div><dt>If true</dt><dd>' + escapeHtml(exp.predictionIfTrue) + '</dd></div>' +
            '<div><dt>If false</dt><dd>' + escapeHtml(exp.predictionIfFalse) + '</dd></div>' +
            '<div><dt>Why informative</dt><dd>' + escapeHtml(exp.whyInformative) + '</dd></div>';
        } else {
          expWrap.style.display = 'none';
        }
      }

      document.querySelectorAll('.wb-node-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.wb-node-btn').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
          render(byId[btn.getAttribute('data-node-id')]);
        });
      });

      document.querySelectorAll('.wb-tab').forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.getAttribute('data-pane');
          document.querySelectorAll('.wb-tab').forEach((t) => t.classList.remove('active'));
          tab.classList.add('active');
          document.querySelectorAll('.wb-pane').forEach((p) => {
            p.classList.remove('active');
            if (p.id === 'pane-map') p.style.display = 'none';
          });
          const pane = document.getElementById('pane-' + id);
          if (!pane) return;
          pane.classList.add('active');
          if (id === 'map') {
            pane.style.display = 'contents';
          } else {
            pane.style.display = 'block';
          }
        });
      });
    </script>
  </body>
</html>
