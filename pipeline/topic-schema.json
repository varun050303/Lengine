{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lengine Topic (v2.0)",
  "description": "A vulnerability-specific reasoning model adhering to the 4 Lengine contracts.",
  "type": "object",
  "required": [
    "schema_version",
    "content_version",
    "topic_id",
    "display_name",
    "status",
    "category",
    "prerequisites",
    "mechanism_family",
    "learning_objectives",
    "safety_contract",
    "implementation_variance",
    "mental_model",
    "invariant",
    "normal_behavior",
    "vulnerable_behavior",
    "causal_mechanism",
    "exploitability",
    "investigation",
    "confirmation",
    "capability_and_impact",
    "defense_analysis",
    "traps",
    "variants",
    "transfer",
    "claims_ref",
    "assessment_ref",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["2.0"] },
    "content_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "topic_id": { "type": "string", "pattern": "^topic\\.[a-z0-9-]+$" },
    "display_name": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "in_review", "approved", "deprecated"] },
    "category": { "type": "string", "enum": ["server-side", "client-side", "advanced"] },
    "aliases": { "type": "array", "items": { "type": "string" } },

    "prerequisites": {
      "type": "array",
      "items": { "type": "string", "pattern": "^concept\\.[a-z0-9-]+$" },
      "description": "IDs of concept files this topic depends on"
    },
    "mechanism_family": {
      "type": "string",
      "pattern": "^mechanism\\.[a-z0-9-]+$",
      "description": "ID of the mechanism family this topic belongs to"
    },

    "learning_objectives": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Observable technical actions the learner can perform after studying this topic"
    },

    "safety_contract": {
      "type": "object",
      "required": [
        "authorization_assumption",
        "scope_constraints",
        "side_effect_risk",
        "data_exposure_risk",
        "stop_conditions",
        "safer_alternative"
      ],
      "properties": {
        "authorization_assumption": { "type": "string" },
        "scope_constraints": { "type": "array", "items": { "type": "string" } },
        "side_effect_risk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "data_exposure_risk": { "type": "string", "enum": ["none", "low", "medium", "high"] },
        "stop_conditions": { "type": "array", "items": { "type": "string" } },
        "safer_alternative": { "type": "string" }
      }
    },

    "implementation_variance": {
      "type": "object",
      "required": ["applies_when", "does_not_apply_when", "variance_notes"],
      "properties": {
        "applies_when": { "type": "array", "items": { "type": "string" } },
        "does_not_apply_when": { "type": "array", "items": { "type": "string" } },
        "variance_notes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "mental_model": {
      "type": "object",
      "required": ["one_sentence", "short_explanation", "diagram"],
      "properties": {
        "one_sentence": { "type": "string" },
        "short_explanation": { "type": "string" },
        "diagram": { "type": "string" },
        "analogy": {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "where_it_breaks": { "type": "string" }
          }
        }
      }
    },

    "invariant": {
      "type": "object",
      "required": ["statement", "why_it_matters", "violation_condition", "investigation_question"],
      "properties": {
        "statement": { "type": "string" },
        "why_it_matters": { "type": "string" },
        "violation_condition": { "type": "string" },
        "investigation_question": { "type": "string" }
      }
    },

    "normal_behavior": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "diagram": { "type": "string" }
      }
    },

    "vulnerable_behavior": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": { "type": "string" },
        "diagram": { "type": "string" }
      }
    },

    "causal_mechanism": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": { "type": "array", "items": { "type": "string" } },
        "data_flow": {
          "type": "object",
          "properties": {
            "source": { "type": "string" },
            "transformations": { "type": "array", "items": { "type": "string" } },
            "parser_or_component": { "type": "string" },
            "sink_or_decision": { "type": "string" },
            "result": { "type": "string" }
          }
        },
        "trust_transformation": {
          "type": "object",
          "properties": {
            "attacker_data": { "type": "string" },
            "parser_or_interpreter": { "type": "string" },
            "new_meaning": { "type": "string" },
            "authority_gained": { "type": "string" },
            "effect": { "type": "string" }
          }
        }
      }
    },

    "exploitability": {
      "type": "object",
      "required": ["conditions"],
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["condition"],
                "properties": {
                  "condition": { "type": "string" },
                  "how_to_test": { "type": "string" }
                }
              },
              {
                "type": "object",
                "required": ["operator", "conditions"],
                "properties": {
                  "operator": { "type": "string", "enum": ["AND", "OR"] },
                  "label": { "type": "string" },
                  "conditions": { "type": "array" }
                }
              }
            ]
          }
        },
        "gate_rule": { "type": "string" }
      }
    },

    "investigation": {
      "type": "object",
      "required": ["attack_surface", "hypotheses", "minimal_experiments"],
      "properties": {
        "attack_surface": { "type": "array", "items": { "type": "string" } },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "hypothesis", "predicted_observation"],
            "properties": {
              "id": { "type": "string" },
              "hypothesis": { "type": "string" },
              "predicted_observation": { "type": "string" }
            }
          }
        },
        "minimal_experiments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["hypothesis", "experiment"],
            "properties": {
              "hypothesis": { "type": "string" },
              "experiment": { "type": "string" },
              "observation_if_true": { "type": "string" },
              "observation_if_false": { "type": "string" },
              "information_gain": { "type": "string" },
              "next_experiment": { "type": "string" }
            }
          }
        },
        "decision_points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "yes": { "type": "string" },
              "no": { "type": "string" }
            }
          }
        }
      }
    },

    "confirmation": {
      "type": "object",
      "required": ["what_must_be_proven", "evidence", "safe_confirmation"],
      "properties": {
        "what_must_be_proven": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "strength": { "type": "string", "enum": ["strong", "moderate", "weak", "insufficient"] },
              "evidence": { "type": "string" },
              "tier": { "type": "string", "enum": ["observed", "strongly_supported", "plausible", "unknown"] }
            }
          }
        },
        "safe_confirmation": { "type": "string" }
      }
    },

    "capability_and_impact": {
      "type": "object",
      "required": ["primitive", "capabilities"],
      "properties": {
        "primitive": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": { "type": "string" },
              "additional_prerequisite": { "type": ["string", "null"] },
              "impact": { "type": "string" }
            }
          }
        },
        "impact_conditions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "defense_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defense", "assumption", "what_must_remain_true", "how_assumption_fails", "investigation"],
        "properties": {
          "defense": { "type": "string" },
          "assumption": { "type": "string" },
          "what_must_remain_true": { "type": "string" },
          "how_assumption_fails": { "type": "string" },
          "investigation": { "type": "string" }
        }
      }
    },

    "traps": {
      "type": "object",
      "properties": {
        "common_misconceptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "misconception": { "type": "string" },
              "why_wrong": { "type": "string" },
              "correct_model": { "type": "string" }
            }
          }
        },
        "false_positives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "observation": { "type": "string" },
              "incorrect_conclusion": { "type": "string" },
              "why_incorrect": { "type": "string" },
              "what_to_verify_next": { "type": "string" }
            }
          }
        },
        "failed_attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attempt": { "type": "string" },
              "result": { "type": "string" },
              "why": { "type": "string" },
              "lesson": { "type": "string" }
            }
          }
        }
      }
    },

    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "condition", "mechanism_detail"],
        "properties": {
          "name": { "type": "string" },
          "condition": { "type": "string" },
          "mechanism_detail": { "type": "string" },
          "investigation_difference": { "type": "string" },
          "how_to_identify": { "type": "string" },
          "how_to_confirm": { "type": "string" }
        }
      }
    },

    "transfer": {
      "type": "object",
      "required": ["shared_mechanism", "related_topics", "new_contexts"],
      "properties": {
        "shared_mechanism": { "type": "string" },
        "related_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic": { "type": "string" },
              "shared_principle": { "type": "string" }
            }
          }
        },
        "transferable_reasoning": { "type": "string" },
        "new_contexts": { "type": "array", "items": { "type": "string" } }
      }
    },

    "claims_ref": { "type": "string" },
    "assessment_ref": { "type": "string" },

    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "tier", "claim", "retrieved_this_pass"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "url": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
          "claim": { "type": "string" },
          "retrieved_this_pass": { "type": "boolean" }
        }
      }
    }
  }
}
